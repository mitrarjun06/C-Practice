/* Print the value of the surface area */

#include <stdio.h>
int main()
{
    int length, width, height, surfacearea;
    scanf("%d %d %d", &length, &width, &height);
    if(length<1 ||length>10 || width<1 || width>10 || height<1 || height>10){
        printf("Invalid input");
    }else{surfacearea = 2*(width*length+length*height+height*width);
        printf("%d", surfacearea);
    }
	return 0;
}
