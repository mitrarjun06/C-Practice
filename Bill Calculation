/* Print total bill amount */

#include <stdio.h>
#include <math.h>
int main()
{
    int unitconsumed, costperunit;
    scanf("%d", &unitconsumed);
    scanf("%d", &costperunit);
    if (unitconsumed<1 || unitconsumed>500 || costperunit<2 || costperunit>10){
        printf("Invalid input");
    }else{
        printf("%.0lf",pow(unitconsumed,costperunit) );
    }
	return 0;
