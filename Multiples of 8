#include <stdio.h>
#include <stdlib.h>
int main()
{
    char digitonwb[1000002] = {0};
    int i;
    scanf("%s", digitonwb);
    long long count = 0;
    int number = atoi(digitonwb);
    if(number<1 || number>100000000){
        printf("Invalid Input");
    }else{
        for(i = 0; digitonwb[i] != '\0'; i++){
            int one = digitonwb[i]-'0';
            if (one % 8 == 0) count++;
        }
        
        for(i = 0; digitonwb[i + 1] != '\0'; i++){
            int ten = (digitonwb[i]-'0')*10 + (digitonwb[i+1]-'0');
            if (digitonwb[i] != '0' && ten % 8 == 0) count++;
        }
        
        for(i = 0; digitonwb[i + 2] != '\0'; i++){
            int hun = (digitonwb[i] - '0')*100 + (digitonwb[i+1]-'0')*10 + (digitonwb[i+2]-'0');
            if (digitonwb[i] != '0' && hun % 8 == 0) count++;
        }
    printf("%lld", count);
    }
	return 0;
}
