/* Print the total delay time in hours and minutes */

#include <stdio.h>
int main()
{
    int tot_mins, hrs, mins;
    int MINaHOUR = 60;
    scanf("%d", &tot_mins);
    if (tot_mins>550 || tot_mins<0){
    printf("Invalid input");
    }else{
    hrs = (tot_mins / MINaHOUR);
    mins = (tot_mins % MINaHOUR);
    printf("%d Hours and %d Minutes", hrs,mins);
    }
    return 0;
}
