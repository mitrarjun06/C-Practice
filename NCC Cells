#include <stdio.h>
int NccCells(int x,int y){
    x = x+1;
    y = y+1;
    return (x/2)*(y/2);
}
int main()
{
    int x,y;
    if (scanf("%d %d", &x,&y) != 2){
        return 0;
    }
    if (x>10 || y>10){
        printf("Invaild.");
        return 0;
    }
    printf("%d\n", NccCells(x,y));
	return 0;}
