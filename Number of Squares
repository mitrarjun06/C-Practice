#include <stdio.h>
#include <math.h>
int main()
{
    long int q,start,end,a,b;
    scanf("%ld",&q);
    if(q<=0||q>=100){
        printf("Invalid Input");
        return 0;
    }
    while(q--){
        scanf("%ld%ld", &start,&end);
        a=ceil(sqrt(start));
        b=floor(sqrt(end));
        long int c = b-a+1;
        if (c<0)c=0;
        printf("%ld\n",c);
    }
	return 0;
}
